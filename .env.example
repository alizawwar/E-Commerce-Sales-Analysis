# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own values.
#
#     cp .env.example .env
#
# .env is listed in .gitignore and must never be committed.
# ---------------------------------------------------------------------------

# MySQL server the dashboard reads from.
DB_HOST=localhost
DB_PORT=3306

# The database built by sql/01_create_database.sql in Phase 3.
DB_NAME=ecommerce_sales_analysis

# A MySQL account. For local analysis a read-only account is ideal:
#
#   CREATE USER 'dashboard_reader'@'localhost' IDENTIFIED BY 'choose-a-password';
#   GRANT SELECT ON ecommerce_sales_analysis.* TO 'dashboard_reader'@'localhost';
#   FLUSH PRIVILEGES;
#
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
